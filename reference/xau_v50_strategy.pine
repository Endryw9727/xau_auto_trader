//@version=6
strategy("XAUUSD Structure Scalper V50 Strategy", overlay=true, initial_capital=1000, currency=currency.USD, pyramiding=0, margin_long=1, margin_short=1, commission_type=strategy.commission.percent, commission_value=0.0, default_qty_type=strategy.fixed, default_qty_value=1, calc_on_every_tick=true, calc_on_order_fills=true, process_orders_on_close=true, max_lines_count=500, max_labels_count=500)
